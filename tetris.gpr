project Tetris is

   for Source_Dirs use (".");
   for Object_Dir  use "obj";
   for Exec_Dir    use ".";
   for Main        use ("tetris.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-gnat2022");
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use ("-lSDL2", "-lSDL2_ttf");
   end Linker;

end Tetris;
